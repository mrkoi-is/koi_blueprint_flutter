.DS_Store
.dart_tool/
.idea/
.vscode/
.fvm/
**/.dart_tool/
**/build/
# Build-cache symlinks are local artifacts too (including unmounted targets).
**/build
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub/
**/coverage/
**/test/golden/failures/
melos_*.iml

# Codegen outputs are not versioned; regenerate via `melos run generate`
**/*.g.dart
**/*.freezed.dart

# Python validation tooling
__pycache__/
*.pyc
.blueprint/upgrades/

# Flutter localization output (regenerate from ARB)
**/lib/l10n/generated/
