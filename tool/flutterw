#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${FLUTTER_BIN:-}" && -x "${FLUTTER_BIN}" ]]; then
  exec "${FLUTTER_BIN}" "$@"
fi

if command -v flutter >/dev/null 2>&1; then
  exec flutter "$@"
fi

if command -v fvm >/dev/null 2>&1; then
  exec fvm flutter "$@"
fi

echo "flutter 未找到。请设置 FLUTTER_BIN，或把 flutter / fvm 放进 PATH。" >&2
exit 127
