{
  "openapi": "3.0.3",
  "info": {
    "title": "Koi Blueprint Admin Example",
    "version": "1.0.0",
    "description": "A local template contract used to verify the generated-client architecture."
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "tags": [
    {
      "name": "System"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Read service health",
        "responses": {
          "200": {
            "description": "Current service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          },
          "version": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ServiceStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "unknown"
        ]
      }
    }
  }
}
