{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrkoi-is/koi_blueprint_flutter/tool/network/migration_manifest.schema.json",
  "title": "Koi Flutter 网络迁移清单",
  "description": "启用 egress manifest 的 migration 门禁后，用接口级证据约束 UI 可达 Legacy 与默认网络栈。",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "backend",
        "method",
        "path",
        "uiReachable",
        "consumer",
        "currentStack",
        "targetStack",
        "status",
        "owner",
        "reason",
        "expiresAt",
        "evidence"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "uiReachable": {
          "type": "boolean"
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "currentStack": {
          "enum": [
            "legacy",
            "koi_generated",
            "external_gateway",
            "retired"
          ]
        },
        "targetStack": {
          "enum": [
            "legacy",
            "koi_generated",
            "external_gateway",
            "retired"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "migrating",
            "migrated",
            "quarantined",
            "exception",
            "retired"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonPlaceholderString"
        },
        "reason": {
          "$ref": "#/$defs/nonPlaceholderString"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "description": "validator 进一步检查仓库内路径真实存在；远程证据仅允许 HTTPS URL",
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)[^?#]+$"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!https?://)(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        }
      ]
    },
    "nonPlaceholderString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:[Rr][Ee][Pp][Ll][Aa][Cc][Ee]|[Tt][Oo][Dd][Oo]|[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|<[^>]*>)).+$"
    }
  }
}
