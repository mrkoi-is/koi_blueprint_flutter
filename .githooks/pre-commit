#!/usr/bin/env bash
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$ROOT_DIR/tool:$PATH"

printf '%b\n' "${YELLOW}Running pre-commit hooks...${NC}"
cd "$ROOT_DIR"

printf '%b\n' "${YELLOW}Running Koi workspace precommit...${NC}"
"$ROOT_DIR/tool/melos" run precommit --no-select

printf '%b\n' "${GREEN}Pre-commit checks passed!${NC}"
