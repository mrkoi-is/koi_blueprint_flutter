#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

echo -e "${YELLOW}Running pre-commit hooks...${NC}"
cd "$ROOT_DIR"

echo -e "${YELLOW}Running Koi workspace precommit...${NC}"
./tool/dartw run melos run precommit --no-select

echo -e "${GREEN}Pre-commit checks passed!${NC}"
